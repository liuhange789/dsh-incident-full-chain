{
  "name": "@liuhange/dsh-incident-full-chain",
  "version": "0.1.0",
  "description": "Incident full chain inside DSH: on-call triage, mitigation timeline, and an auto-generated postmortem.md with MTTR. 故障全链路：值班定性、记录缓解动作、一键沉淀复盘报告。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "incident",
    "oncall",
    "postmortem",
    "sre",
    "mttr",
    "故障",
    "复盘",
    "值班"
  ],
  "homepage": "https://github.com/liuhange789/dsh-incident-full-chain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/dsh-incident-full-chain.git"
  },
  "bugs": {
    "url": "https://github.com/liuhange789/dsh-incident-full-chain/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test test/host.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
